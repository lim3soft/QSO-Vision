            "get": {
                "tags": [
                    "Device"
                ],
                "summary": "Shows profile of the specified device id",
                "description": "Shows the repeater configuration as known by the last master the repeater was/is connected to. This is not real-time data; clients should not poll this endpoint more than once per minute.",
                "operationId": "device.profile",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the device",
                        "required": true,
