{
    "openapi": "3.0.0",
    "info": {
        "title": "Halligan API",
        "description": "BrandMeister Dashboard Restfull API",
        "version": "2.1.0"
    },
    "servers": [
        {
            "url": "https://api.brandmeister.network/v2/"
        }
    ],
    "paths": {
        "/device": {
            "get": {
                "tags": [
                    "Device"
                ],
                "summary": "Lists all devices seen on the network in the last day (repeaters & hotspots)",
                "description": "This response is cached and is not real-time data; clients should not poll this endpoint more than once every 15 minutes.",
                "operationId": "device.all",
                "parameters": [
                    {
                        "name": "repeater",
                        "in": "query",
                        "description": "Only list 6-digit repeaters seen in the last 7 days",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/DeviceIndex"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "unsupported query parameter"
                    }
                }
            }
        },
        "/device/{id}": {
            "get": {
                "tags": [
                    "Device"
                ],
                "summary": "Shows all info about the specified device id",
                "operationId": "device.byID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the device",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "uint64"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": "successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Device"
                                }
                            }
                        }
                    }
                }
            }
        },
